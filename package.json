{
  "name": "kaarnegar",
  "version": "1.0.2",
  "private": true,
  "description": "Persian offline time tracker with Jalali reports",
  "author": "Meysam Shams",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "tsx --test tests/model.test.ts tests/preferences.test.cjs tests/workspace.test.ts",
    "test:app": "node tests/app.cjs && node tests/workspace-app.cjs",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-icon.ps1",
    "package": "npm run build && electron-builder --win --x64 --publish never",
    "package:portable": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "jalaali-js": "^1.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/jalaali-js": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "ir.kaarnegar.desktop",
    "productName": "Kaarnegar",
    "copyright": "Copyright © 2026 Meysam Shams",
    "beforeBuild": "scripts/before-build.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Kaarnegar.exe"
    },
    "nsis": {
      "artifactName": "Kaarnegar-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "کارنگار",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "fa_IR",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
