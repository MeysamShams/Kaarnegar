{
  "name": "kaarnegar",
  "version": "1.0.0",
  "private": true,
  "description": "Persian offline time tracker with Jalali reports",
  "author": "Kaarnegar",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "tsx --test tests/model.test.ts",
    "test:app": "node tests/app.cjs",
    "package": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "jalaali-js": "^1.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/jalaali-js": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "fontkit": "^2.0.4",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "ir.kaarnegar.desktop",
    "productName": "Kaarnegar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Kaarnegar.exe"
    }
  }
}
